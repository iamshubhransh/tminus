{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023"],
    "types": ["bun"],
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": false,
    "paths": {
      "@tminus/core": ["./packages/core/src/index.ts"],
      "@tminus/adapters": ["./packages/adapters/src/index.ts"],
      "@tminus/render": ["./packages/render/src/index.ts"]
    }
  },
  "include": ["packages/*/src/**/*.ts", "tests/**/*.ts", "scripts/**/*.ts", "lab/*.ts"]
}
